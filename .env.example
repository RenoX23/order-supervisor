# Copy to `.env` and adjust as needed:  cp .env.example .env
# This file is read by both docker-compose and the backend.

# ── Postgres (application database) ───────────────────────────────────────────
POSTGRES_USER=supervisor
POSTGRES_PASSWORD=supervisor
POSTGRES_DB=order_supervisor
# Host port the container's 5432 is published on (5442 avoids a local 5432 clash).
POSTGRES_HOST_PORT=5442

# Connection string used by the backend (asyncpg). Points at the mapped host port.
DATABASE_URL=postgresql://supervisor:supervisor@localhost:5442/order_supervisor

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor

# ── LLM (agent step) — OpenAI-compatible; defaults to Groq's free tier ────────
# Create a free key at https://console.groq.com and paste it below.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# To use OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# To use Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  (LLM_API_KEY=ollama)
